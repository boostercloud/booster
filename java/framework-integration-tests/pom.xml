<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.boostercloud</groupId>
    <artifactId>booster-parent</artifactId>
    <version>4.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>booster-framework-integration-tests</artifactId>
  <name>Booster integration tests</name>
  <description>Sample application ("my-store") and end-to-end tests on the local provider.</description>

  <properties>
    <!-- The application's main class, as in a project generated by the boost CLI -->
    <booster.mainClass>com.boostercloud.integration.Main</booster.mainClass>
    <!-- Per-test timeout of the end-to-end suites (TypeScript: mocha timeout 3600000 ms) -->
    <e2e.timeout>3600 s</e2e.timeout>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local</artifactId>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure-infrastructure</artifactId>
    </dependency>

    <!-- End-to-end harness -->
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-application-tester</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Like a project generated by the boost CLI: the runtime class path is copied to target/lib during
           package, and the application is launched with java -cp target/classes:target/lib/* <main class> -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -B -Pe2e -pl framework-integration-tests -am verify: runs the *IT end-to-end suites against the
         application started in separate JVMs on the local provider (TypeScript: npm run integration/local) -->
    <profile>
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>end-to-end</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <!-- One test JVM for the whole run: the shared application process lives as long as it -->
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
              <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
              <environmentVariables>
                <!-- What npm run integration/local-end-to-end sets -->
                <TESTED_PROVIDER>LOCAL</TESTED_PROVIDER>
                <BOOSTER_ENV>local</BOOSTER_ENV>
              </environmentVariables>
              <systemPropertyVariables>
                <booster.e2e.moduleDirectory>${project.basedir}</booster.e2e.moduleDirectory>
                <booster.e2e.mainClass>${booster.mainClass}</booster.e2e.mainClass>
                <junit.jupiter.execution.timeout.default>${e2e.timeout}</junit.jupiter.execution.timeout.default>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
