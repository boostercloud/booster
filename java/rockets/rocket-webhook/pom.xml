<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.boostercloud</groupId>
    <artifactId>booster-parent</artifactId>
    <version>4.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>booster-rocket-webhook</artifactId>
  <name>Booster webhook rocket</name>
  <description>Webhook rocket (types, core, local and Azure infrastructure).</description>

  <dependencies>
    <!-- types + core: what every application using the rocket needs at runtime -->
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-core</artifactId>
    </dependency>

    <!--
      The provider parts (TypeScript: the separate -local-infrastructure / -azure-infrastructure npm packages) are
      optional: an application already depends on the provider (and its infrastructure) it runs on, and does not get
      the other provider's libraries through this rocket.
    -->
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local-infrastructure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure-infrastructure</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Tests: the application tester drives the in-process end-to-end application -->
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-application-tester</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
