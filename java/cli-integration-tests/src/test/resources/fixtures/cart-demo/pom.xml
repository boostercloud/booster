<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>project_name_placeholder</artifactId>
  <version>version_placeholder</version>
  <packaging>jar</packaging>

  <name>project_name_placeholder</name>
  <description>description_placeholder</description>
  <url>homepage_placeholder</url>

  <licenses>
    <license>
      <name>license_placeholder</name>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>author_placeholder</name>
    </developer>
  </developers>

  <scm>
    <url>repository_placeholder</url>
  </scm>

  <properties>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- New projects use the same Booster version as the CLI that created them -->
    <booster.version>booster_version_placeholder</booster.version>
    <!-- The class whose main method calls Booster.run: the boost CLI launches it (start, deploy, synth, nuke) -->
    <booster.mainClass>com.example.base_package_placeholder.Main</booster.mainClass>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-core</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local-infrastructure</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-azure-infrastructure</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <!-- Booster reads the parameter names of handlers, reducers and projections reflectively -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <!-- Copies the runtime dependencies to target/lib: the boost CLI runs target/classes plus target/lib/* -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
