<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The application every CLI sandbox starts from (the Java counterpart of the TypeScript integration-test app that
    createSandboxProject copies). booster_version_placeholder is replaced with the CLI version when a sandbox is
    created, the way the TypeScript suite rewrites the @boostercloud dependencies of the copied package.json.
  -->
  <groupId>com.example</groupId>
  <artifactId>cart-demo</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>cart-demo</name>
  <description>The application used by the Booster CLI integration tests</description>

  <properties>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <booster.version>booster_version_placeholder</booster.version>
    <booster.mainClass>com.example.cartdemo.Main</booster.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-core</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local</artifactId>
      <version>${booster.version}</version>
    </dependency>
    <dependency>
      <groupId>com.boostercloud</groupId>
      <artifactId>booster-framework-provider-local-infrastructure</artifactId>
      <version>${booster.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
